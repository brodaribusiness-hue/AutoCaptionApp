<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.saad.autocaption.AspectRatioFrameLayout
            android:id="@+id/videoPreviewContainer"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_gravity="center_horizontal"
            android:background="#000000">

            <SurfaceView
                android:id="@+id/videoSurface"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/captionsOverlayLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal"
                android:clipChildren="false"
                android:clipToPadding="false">

                <TextView
                    android:id="@+id/wordSlotBefore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:textColor="#CCCCCC"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/wordSlotActive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:textColor="#FFFF00"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/wordSlotAfter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:textColor="#CCCCCC"
                    android:textSize="22sp" />
            </LinearLayout>
        </com.saad.autocaption.AspectRatioFrameLayout>

        <!-- Player Controls -->
        <LinearLayout
            android:id="@+id/playerControlLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:background="#1E1E1E"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/playPauseButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pause"
                android:textSize="12sp"
                android:textColor="#FFFFFF" />

            <SeekBar
                android:id="@+id/videoSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/timeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/selectVideoButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Select Video" />

        <Button
            android:id="@+id/generateCaptionsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Generate Captions" />

        <!-- 3 Slots Segmented Tab Selector -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configure Target Slot:"
            android:textColor="#00E676"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:background="#1F1F1F"
            android:padding="3dp">

            <Button
                android:id="@+id/btnSlotBefore"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="1. Before"
                android:textSize="12sp"
                android:textColor="#AAAAAA"
                android:backgroundTint="#2C2C2C" />

            <Button
                android:id="@+id/btnSlotActive"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="2. Active"
                android:textSize="12sp"
                android:textColor="#000000"
                android:backgroundTint="#00E676" />

            <Button
                android:id="@+id/btnSlotAfter"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="3. After"
                android:textSize="12sp"
                android:textColor="#AAAAAA"
                android:backgroundTint="#2C2C2C" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Font Family:"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:layout_marginTop="10dp" />

        <Spinner
            android:id="@+id/fontStyleSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#2A2A2A"
            android:padding="8dp"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Slot Text Color:"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:layout_marginTop="10dp" />

        <Spinner
            android:id="@+id/captionColorSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#2A2A2A"
            android:padding="8dp"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Slot Style:"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:layout_marginTop="10dp" />

        <Spinner
            android:id="@+id/captionStyleSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#2A2A2A"
            android:padding="8dp"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/boxColorButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Set Box Background Color" />

        <Button
            android:id="@+id/exportButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Export Video" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#AAAAAA"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>

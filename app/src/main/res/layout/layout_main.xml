<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auto Caption"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_marginBottom="14dp" />

        <com.saad.autocaption.AspectRatioFrameLayout
            android:id="@+id/videoPreviewContainer"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_gravity="center_horizontal"
            android:background="#000000">

            <SurfaceView
                android:id="@+id/videoSurface"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <FrameLayout
                android:id="@+id/captionLayer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:elevation="10dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <TextView
                    android:id="@+id/wordSlotBefore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="40dp"
                    android:textColor="#CCCCCC"
                    android:textSize="22sp"
                    android:elevation="12dp"
                    android:padding="4dp" />

                <TextView
                    android:id="@+id/wordSlotActive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="40dp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="22sp"
                    android:elevation="12dp"
                    android:padding="4dp" />

                <TextView
                    android:id="@+id/wordSlotAfter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="40dp"
                    android:textColor="#CCCCCC"
                    android:textSize="22sp"
                    android:elevation="12dp"
                    android:padding="4dp" />

            </FrameLayout>

        </com.saad.autocaption.AspectRatioFrameLayout>

        <!-- Player Controls Bar -->
        <LinearLayout
            android:id="@+id/playerControlLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:background="#1E1E1E"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/playPauseButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Pause"
                android:textSize="12sp"
                android:textColor="#FFFFFF" />

            <SeekBar
                android:id="@+id/videoSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/timeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/selectVideoButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Video"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/generateCaptionsButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Generate Captions" />

            <Button
                android:id="@+id/exportButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Export" />

        </LinearLayout>

        <!-- Slot Picker Tab Bar -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configure Word Slot:"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btnSlotBefore"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="1. Before"
                android:textSize="11sp"
                android:textColor="#CCCCCC"
                android:backgroundTint="#333333" />

            <Button
                android:id="@+id/btnSlotActive"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="2. Active"
                android:textSize="11sp"
                android:textColor="#000000"
                android:backgroundTint="#00E676" />

            <Button
                android:id="@+id/btnSlotAfter"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="3. After"
                android:textSize="11sp"
                android:textColor="#CCCCCC"
                android:backgroundTint="#333333" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Font Style"
            android:textColor="#CCCCCC"
            android:textSize="13sp"
            android:layout_marginTop="12dp" />

        <Spinner
            android:id="@+id/fontStyleSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E1E1E"
            android:popupBackground="#1E1E1E"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Word Color"
            android:textColor="#CCCCCC"
            android:textSize="13sp"
            android:layout_marginTop="10dp" />

        <Spinner
            android:id="@+id/captionColorSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E1E1E"
            android:popupBackground="#1E1E1E"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Word Effect / Style"
            android:textColor="#CCCCCC"
            android:textSize="13sp"
            android:layout_marginTop="10dp" />

        <Spinner
            android:id="@+id/captionStyleSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E1E1E"
            android:popupBackground="#1E1E1E"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/boxColorButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Box Background Color"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select a video to start"
            android:textSize="14sp"
            android:textColor="#AAAAAA"
            android:gravity="center"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>

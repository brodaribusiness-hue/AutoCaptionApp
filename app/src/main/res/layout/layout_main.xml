<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@color/bg_primary"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auto Caption"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_marginBottom="14dp" />

        <com.saad.autocaption.AspectRatioFrameLayout
            android:id="@+id/videoPreviewContainer"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_gravity="center_horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:background="@color/color_black">

            <SurfaceView
                android:id="@+id/videoSurface"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/desc_video_surface" />

            <LinearLayout
                android:id="@+id/captionLayer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:elevation="30dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <TextView
                    android:id="@+id/wordSlotBefore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/caption_secondary"
                    android:textSize="22sp"
                    android:elevation="35dp"
                    android:padding="6dp" />

                <TextView
                    android:id="@+id/wordSlotActive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="22sp"
                    android:elevation="35dp"
                    android:padding="6dp" />

                <TextView
                    android:id="@+id/wordSlotAfter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/caption_secondary"
                    android:textSize="22sp"
                    android:elevation="35dp"
                    android:padding="6dp" />

            </LinearLayout>

        </com.saad.autocaption.AspectRatioFrameLayout>

        <!-- Player Controls Bar -->
        <LinearLayout
            android:id="@+id/playerControlLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:background="@color/control_bg"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/playPauseButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Pause"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:contentDescription="@string/desc_play_pause" />

            <SeekBar
                android:id="@+id/videoSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/timeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/selectVideoButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Video"
            android:contentDescription="@string/desc_select_video"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/generateCaptionsButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Generate Captions"
                android:contentDescription="@string/desc_generate_captions" />

            <Button
                android:id="@+id/exportButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Export"
                android:contentDescription="@string/desc_export" />

        </LinearLayout>

        <!-- Slot Picker Tab Bar -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configure Word Slot:"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btnSlotBefore"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="1. Before"
                android:textSize="11sp"
                android:textColor="@color/caption_secondary"
                android:background="@color/btn_bg_dark"
                android:contentDescription="@string/desc_slot_before" />

            <Button
                android:id="@+id/btnSlotActive"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="2. Active"
                android:textSize="11sp"
                android:textColor="@color/black"
                android:background="@color/accent_green"
                android:contentDescription="@string/desc_slot_active" />

            <Button
                android:id="@+id/btnSlotAfter"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="3. After"
                android:textSize="11sp"
                android:textColor="@color/caption_secondary"
                android:background="@color/btn_bg_dark"
                android:contentDescription="@string/desc_slot_after" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Font Style"
            android:textColor="@color/caption_secondary"
            android:textSize="13sp"
            android:layout_marginTop="12dp" />

        <Spinner
            android:id="@+id/fontStyleSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/control_bg"
            android:popupBackground="@color/control_bg"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Word Color"
            android:textColor="@color/caption_secondary"
            android:textSize="13sp"
            android:layout_marginTop="10dp" />

        <Spinner
            android:id="@+id/captionColorSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/control_bg"
            android:popupBackground="@color/control_bg"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Word Effect / Style"
            android:textColor="@color/caption_secondary"
            android:textSize="13sp"
            android:layout_marginTop="10dp" />

        <Spinner
            android:id="@+id/captionStyleSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/control_bg"
            android:popupBackground="@color/control_bg"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/boxColorButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Box Background Color"
            android:layout_marginTop="10dp"
            android:contentDescription="@string/desc_box_color" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select a video to start"
            android:textSize="14sp"
            android:textColor="@color/text_muted"
            android:gravity="center"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
